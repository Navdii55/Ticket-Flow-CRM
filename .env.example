# -----------------------------------------------------------------
# Environment variables for the Customer Support Ticketing CRM API.
# Copy this file to `.env` and adjust values as needed.
# All variables here are read centrally by app/config.py — no other
# file reads environment variables directly.
# -----------------------------------------------------------------

# Database connection string.
# Default (if omitted) is a local SQLite file: sqlite:///./support_crm.db
DATABASE_URL=sqlite:///./support_crm.db

# Application metadata — shown in the Swagger UI (/docs) title/version.
APP_NAME=Customer Support Ticketing CRM
APP_VERSION=1.0.0

# API route prefix (reserved for future use).
API_PREFIX=/api

# Comma-separated list of allowed CORS origins (no spaces needed, but
# tolerated — they're trimmed). This should be the URL(s) of your
# frontend.
#
# Local development (Vite default):
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Production example — replace with your deployed frontend URL:
# CORS_ORIGINS=https://your-frontend.vercel.app
